# BusyBox/POSIX sh mDNS announcement-only script.
#
# Announces:
#   HOSTNAME.local -> all active IPv4 addresses
#   HOSTNAME.local -> all active IPv6 addresses
#
# Optional services:
#   SSH  (_ssh._tcp.local)
#   HTTP (_http._tcp.local)
#
# IPv6 announcements are enabled by default and can be disabled with:
#
#   ADVERTISE_IPV6=0 ./tiny-mdns-ann
#
# This sends unsolicited announcements only. It does not answer queries.
#
# IPv6 requires an nc implementation that accepts scoped IPv6 addresses,
# for example:
#
#   nc -u -p 5353 -s 'fe80::1%wlan0' -w 1 \
#      'ff02::fb%wlan0' 5353
#
# BusyBox nc does not expose IP_MULTICAST_TTL or IPV6_MULTICAST_HOPS.
# Consequently, IPv4 and IPv6 packets may not use the mDNS-required
# TTL/hop limit of 255.

VERSION="0.4"

SCRIPT="${0##*/}"

error()
{
	echo "$SCRIPT: $*" >&2
}

if [ "$(id -u)" -ne 0 ]; then
	error "Please run with administrator privileges."
	exit 1
fi

alias _logger='logger -st "$SCRIPT"'


# ----------------------------------------------------------------------
# Base configuration
# ----------------------------------------------------------------------

: "${HOSTNAME:=$(hostname 2>/dev/null || printf '%s' my-host)}"

: "${ADVERTISE_HTTP:=0}"
: "${HTTP_PORT:=80}"
: "${HTTP_PATH:=/}"

: "${ADVERTISE_SSH:=0}"
: "${SSH_PORT:=22}"

: "${INTERVAL:=60}"
: "${ADVERTISE_IPV6:=1}"
: "${USE_SOURCE_ADDRESS:=1}"
: "${DEBUG_LOG:=0}"

MDNS_GROUP4="224.0.0.251"
MDNS_GROUP6="ff02::fb"
MDNS_PORT=5353
DNS_TTL=120

# ----------------------------------------------------------------------
# Convert IPv4 address to hexadecimal bytes.
# ----------------------------------------------------------------------

ipv4_to_hex()
{
	ip_address=$1

	old_ifs=$IFS
	IFS=.
	# The value is obtained from ip(8).
	# shellcheck disable=SC2086
	set -- $ip_address
	IFS=$old_ifs

	[ "$#" -eq 4 ] || return 1

	printf '%02x%02x%02x%02x' "$1" "$2" "$3" "$4"
}


# ----------------------------------------------------------------------
# Convert an IPv6 address to 32 hexadecimal digits.
#
# The input must not contain a prefix length or zone identifier.
# ----------------------------------------------------------------------

ipv6_to_hex()
{
	ip_address=$1

	case "$ip_address" in
		*/*|*%*)
			return 1
			;;
	esac

	awk '
	function valid_hextet(value) {
		return value != "" &&
			length(value) <= 4 &&
			value ~ /^[[:xdigit:]]+$/
	}

	function count_part(part,    count, values, i) {
		if (part == "")
			return 0

		count = split(part, values, ":")

		for (i = 1; i <= count; i++) {
			if (!valid_hextet(values[i]))
				exit 1
		}

		return count
	}

	function emit_part(part,    count, values, i, value) {
		if (part == "")
			return

		count = split(part, values, ":")

		for (i = 1; i <= count; i++) {
			value = values[i]
			printf "%s", substr("0000" value, length("0000" value) - 3)
		}
	}

	{
		address = $0
		double_colon = index(address, "::")

		if (double_colon) {
			left_part = substr(address, 1, double_colon - 1)
			right_part = substr(address, double_colon + 2)

			if (index(right_part, "::"))
				exit 1

			left_count = count_part(left_part)
			right_count = count_part(right_part)

			if (left_count + right_count >= 8)
				exit 1

			emit_part(left_part)

			for (i = left_count + right_count; i < 8; i++)
				printf "0000"

			emit_part(right_part)
		} else {
			count = count_part(address)

			if (count != 8)
				exit 1

			emit_part(address)
		}

		printf "\n"
	}
	' <<EOF
$ip_address
EOF
}


# ----------------------------------------------------------------------
# Encode a dotted DNS name as hexadecimal DNS labels.
#
# Example:
#   mybox.local
# becomes:
#   056d79626f78056c6f63616c00
# ----------------------------------------------------------------------

dns_name_hex()
{
	remaining=$1
	encoded_name=""

	while [ -n "$remaining" ]; do
		case "$remaining" in
			*.*)
				label=${remaining%%.*}
				remaining=${remaining#*.}
				;;
			*)
				label=$remaining
				remaining=""
				;;
		esac

		[ -n "$label" ] || return 1
		[ "${#label}" -le 63 ] || return 1

		label_length=$(printf '%02x' "${#label}") || return 1
		label_hex=$(printf '%s' "$label" |
			od -An -tx1 | tr -d ' \n') || return 1

		encoded_name=${encoded_name}${label_length}${label_hex}
	done

	printf '%s00' "$encoded_name"
}


# ----------------------------------------------------------------------
# Convert hexadecimal packet data to printf %b escape text.
#
# Example:
#   aabb -> \xaa\xbb
# ----------------------------------------------------------------------

packet_from_hex()
{
	hex_packet=$1
	payload=""
	offset=1

	while [ "$offset" -le "${#hex_packet}" ]; do
		byte=$(printf '%s' "$hex_packet" |
			cut -c "$offset-$((offset + 1))")

		payload=${payload}\\x${byte}
		offset=$((offset + 2))
	done

	printf '%s' "$payload"
}


# ----------------------------------------------------------------------
# Build an A-record announcement.
# ----------------------------------------------------------------------

make_a_record_payload()
{
	ip_address=$1

	address_hex=$(ipv4_to_hex "$ip_address") || return 1
	name_hex=$(dns_name_hex "${HOSTNAME}.local") || return 1
	ttl_hex=$(printf '%08x' "$DNS_TTL") || return 1

	dns_header="000084000000000100000000"

	dns_record="${name_hex}00018001${ttl_hex}0004${address_hex}"

	packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build an AAAA-record announcement.
# ----------------------------------------------------------------------

make_aaaa_record_payload()
{
	ip_address=$1

	address_hex=$(ipv6_to_hex "$ip_address") || return 1
	[ "${#address_hex}" -eq 32 ] || return 1

	name_hex=$(dns_name_hex "${HOSTNAME}.local") || return 1
	ttl_hex=$(printf '%08x' "$DNS_TTL") || return 1

	dns_header="000084000000000100000000"
	dns_record="${name_hex}001c8001${ttl_hex}0010${address_hex}"

	packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build a PTR-record announcement.
# ----------------------------------------------------------------------

make_ptr_record_payload()
{
	service_name=$1
	instance_name=$2

	service_hex=$(dns_name_hex "${service_name}.local") || return 1
	target_hex=$(dns_name_hex \
		"${instance_name}.${service_name}.local") || return 1

	target_length=$(( ${#target_hex} / 2 ))
	target_length_hex=$(printf '%04x' "$target_length") || return 1
	ttl_hex=$(printf '%08x' "$DNS_TTL") || return 1

	dns_header="000084000000000100000000"

	dns_record="${service_hex}000c0001${ttl_hex}"
	dns_record=${dns_record}${target_length_hex}${target_hex}

	packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build an SRV-record announcement.
# ----------------------------------------------------------------------

make_srv_record_payload()
{
	instance_name=$1
	service_name=$2
	port=$3
	target_host=$4

	name_hex=$(dns_name_hex \
		"${instance_name}.${service_name}.local") || return 1
	target_hex=$(dns_name_hex "${target_host}.local") || return 1

	port_hex=$(printf '%04x' "$port") || return 1
	target_length=$(( ${#target_hex} / 2 ))
	record_length=$((6 + target_length))
	record_length_hex=$(printf '%04x' "$record_length") || return 1
	ttl_hex=$(printf '%08x' "$DNS_TTL") || return 1

	dns_header="000084000000000100000000"

	dns_record="${name_hex}00210001${ttl_hex}${record_length_hex}"
	dns_record=${dns_record}00000000${port_hex}${target_hex}

	packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build a TXT-record announcement.
# ----------------------------------------------------------------------

make_txt_record_payload()
{
	instance_name=$1
	service_name=$2
	txt_value=$3

	name_hex=$(dns_name_hex \
		"${instance_name}.${service_name}.local") || return 1

	if [ -n "$txt_value" ]; then
		txt_bytes=$(printf '%s' "$txt_value" |
			od -An -tx1 | tr -d ' \n') || return 1
		txt_length=$(printf '%02x' "${#txt_value}") || return 1
		txt_hex=${txt_length}${txt_bytes}
	else
		txt_hex="00"
	fi

	record_length=$(( ${#txt_hex} / 2 ))
	record_length_hex=$(printf '%04x' "$record_length") || return 1
	ttl_hex=$(printf '%08x' "$DNS_TTL") || return 1

	dns_header="000084000000000100000000"

	dns_record="${name_hex}00108001${ttl_hex}"
	dns_record=${dns_record}${record_length_hex}${txt_hex}

	packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Send an escaped packet through nc.
# ----------------------------------------------------------------------

send_payload()
{
	payload=$1
	source_address=$2
	destination_address=$3

	if [ "$USE_SOURCE_ADDRESS" -eq 1 ]; then
		printf '%b' "$payload" |
			nc -u -p "$MDNS_PORT" \
				-s "$source_address" \
				-w 1 \
				"$destination_address" "$MDNS_PORT" \
				>/dev/null 2>&1
	else
		printf '%b' "$payload" |
			nc -u -p "$MDNS_PORT" \
				-w 1 \
				"$destination_address" "$MDNS_PORT" \
				>/dev/null 2>&1
	fi
}


# ----------------------------------------------------------------------
# Announce one IPv4 or IPv6 address.
# ----------------------------------------------------------------------

announce_address()
{
	family=$1
	iface=$2
	ip_address=$3

	case "$family" in
		4)
			source_address=$ip_address
			destination_address=$MDNS_GROUP4
			payload=$(make_a_record_payload "$ip_address") || return 1
			;;

		6)
			source_address=$ip_address
			destination_address=${MDNS_GROUP6}%${iface}

			case "$ip_address" in
				fe80:*)
					source_address=${ip_address}%${iface}
					;;
			esac

			payload=$(make_aaaa_record_payload "$ip_address") || return 1
			;;

		*)
			return 1
			;;
	esac

	if [ "$DEBUG_LOG" -eq 1 ]; then
		_logger "Announcing ${HOSTNAME}.local -> ${ip_address} via ${iface} (IPv${family})"
	fi

	send_payload "$payload" "$source_address" \
		"$destination_address" || return 1

	if [ "$ADVERTISE_SSH" -eq 1 ]; then
		instance="${HOSTNAME} SSH"

		payload=$(make_ptr_record_payload \
			"_ssh._tcp" "$instance") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1

		payload=$(make_srv_record_payload \
			"$instance" "_ssh._tcp" "$SSH_PORT" "$HOSTNAME") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1

		payload=$(make_txt_record_payload \
			"$instance" "_ssh._tcp" "") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1
	fi

	if [ "$ADVERTISE_HTTP" -eq 1 ]; then
		instance="${HOSTNAME} Web"

		payload=$(make_ptr_record_payload \
			"_http._tcp" "$instance") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1

		payload=$(make_srv_record_payload \
			"$instance" "_http._tcp" "$HTTP_PORT" "$HOSTNAME") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1

		payload=$(make_txt_record_payload \
			"$instance" "_http._tcp" "path=${HTTP_PATH}") || return 1
		send_payload "$payload" "$source_address" \
			"$destination_address" || return 1
	fi
}


# ----------------------------------------------------------------------
# Enumerate active IPv4 addresses.
# ----------------------------------------------------------------------

send_ipv4_announcements()
{
	ip -o -4 addr show up 2>/dev/null |
		while read -r _ iface _ address _; do
			ip_address=${address%/*}

			case "$ip_address" in
				127.*|0.*|169.254.*)
					continue
					;;
			esac

			announce_address 4 "$iface" "$ip_address" || {
				error "Failed to announce IPv4 $ip_address on $iface"
			}
		done
}


# ----------------------------------------------------------------------
# Enumerate active IPv6 addresses.
# ----------------------------------------------------------------------

send_ipv6_announcements()
{
	[ "$ADVERTISE_IPV6" -eq 1 ] || return 0

	ip -o -6 addr show up 2>/dev/null |
		while read -r _ iface _ address _ scope _; do
			ip_address=${address%/*}

			case "$ip_address" in
				::|::1|ff*|0:*)
					continue
					;;
			esac

			case "$scope" in
				global|link)
					;;
				*)
					continue
					;;
			esac

			announce_address 6 "$iface" "$ip_address" || {
				error "Failed to announce IPv6 $ip_address on $iface"
			}
		done
}


# ----------------------------------------------------------------------
# Enumerate and announce all configured addresses.
# ----------------------------------------------------------------------

send_all_announcements()
{
	send_ipv4_announcements
	send_ipv6_announcements
}


# ----------------------------------------------------------------------
# Usage.
# ----------------------------------------------------------------------

usage()
{
	if [ "$2" ]; then
		error "$2"
	fi

	if [ "$1" -eq 0 ]; then
		output_fd=1
	else
		output_fd=2
	fi

	cat >&"$output_fd" <<EOF

usage: $SCRIPT [OPTIONS]

Announce HOSTNAME.local over mDNS on active interfaces.

Options:
  --help              Show this help.
  --host NAME         Host name to announce in the .local domain.
  --http[=PORT]       Advertise HTTP, default port 80.
  --ssh[=PORT]        Advertise SSH, default port 22.

Environment:
  ADVERTISE_IPV6      Enable IPv6 announcements, default 1.
  INTERVAL            Announcement interval, default 60.
  USE_SOURCE_ADDRESS  Use nc -s, default 1.
  DEBUG_LOG	          Log each announcement, default 0.

Notes:
  IPv6 link-local multicast requires interface scoping; this is handled
  automatically by the announcer.
  BusyBox nc may not expose multicast TTL/hop-limit controls, so
  announcements may not use the mDNS-required value of 255.

EOF

	exit "$1"
}


# ----------------------------------------------------------------------
# Main.
# ----------------------------------------------------------------------

command -v nc >/dev/null 2>&1 ||
	usage 1 "This tool requires netcat."

command -v ip >/dev/null 2>&1 ||
	usage 1 "This tool requires ip."

command -v getopt >/dev/null 2>&1 ||
	usage 1 "This tool requires getopt."

OPTS=$(getopt -o "" \
	-l help,host:,http::,ssh:: \
	-n "$SCRIPT" -- "$@") || usage 1

# getopt output is shell syntax by design.
# shellcheck disable=SC2086
eval set -- "$OPTS"

while [ "$1" != "--" ]; do
	case "$1" in
		--help)
			echo "$SCRIPT $VERSION"
			usage 0
			;;

		--host)
			shift
			HOSTNAME=$1
			;;

		--http)
			ADVERTISE_HTTP=1
			if [ -n "$2" ]; then
				HTTP_PORT=$2
				shift
			fi
			;;

		--ssh)
			ADVERTISE_SSH=1
			if [ -n "$2" ]; then
				SSH_PORT=$2
				shift
			fi
			;;
	esac

	shift
done


# ----------------------------------------------------------------------
# Parameter validation.
# ----------------------------------------------------------------------

case "$HOSTNAME" in
	""|*[!A-Za-z0-9-]*)
		usage 1 "Invalid HOSTNAME: use only letters, digits, and '-'."
		;;
esac

if [ "${#HOSTNAME}" -gt 63 ]; then
	usage 1 "HOSTNAME is longer than 63 characters."
fi

case "$INTERVAL:$MDNS_PORT:$DNS_TTL:$SSH_PORT:$HTTP_PORT" in
	*[!0-9:]*)
		usage 1 "INTERVAL, ports, and DNS_TTL must be numeric."
		;;
esac

case "$ADVERTISE_IPV6:$ADVERTISE_SSH:$ADVERTISE_HTTP:$USE_SOURCE_ADDRESS:$DEBUG_LOG" in
	*[!01:]*)
		usage 1 "Feature flags must be 0 or 1."
		;;
esac


_logger "Starting Tiny mDNS announcer v$VERSION by macmpi for ${HOSTNAME}.local"
if [ "$DEBUG_LOG" -eq 1 ]; then
	_logger "IPv6 announcements: ${ADVERTISE_IPV6}"
fi
# Initial announcement burst.
send_all_announcements
sleep 1
send_all_announcements
sleep 2
send_all_announcements

# Periodic announcements.
while :; do
	sleep "$INTERVAL"
	send_all_announcements
done
