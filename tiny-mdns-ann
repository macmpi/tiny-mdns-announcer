# BusyBox/POSIX sh mDNS announcement-only script.
#
# Announces:
#   HOSTNAME.local -> every active IPv4 address
#
# Optional services:
#   SSH  (_ssh._tcp.local)
#   HTTP (_http._tcp.local)
#
# This sends unsolicited announcements only. It does not answer queries.
#


VERSION="0.3"

SCRIPT="${0##*/}"
error() {
	echo "$SCRIPT: $1" >&2
}

! [ "$(id -u)" -eq 0 ] && { error "Please run with administrator privileges."; exit 1; }

alias _logger='logger -st "$SCRIPT"'


# ----------------------------------------------------------------------
# Base Configuration
# ----------------------------------------------------------------------

: "${INTERVAL:=60}"

MDNS_GROUP="224.0.0.251"
MDNS_PORT=5353
DNS_TTL=120

ADVERTISE_HTTP=0
HTTP_PORT=80
HTTP_PATH="/"

ADVERTISE_SSH=0
SSH_PORT=22

# Set to 0 if this BusyBox nc does not support -s.
: "${USE_SOURCE_ADDRESS:=1}"


# ----------------------------------------------------------------------
# Convert IPv4 address to hexadecimal bytes
# ----------------------------------------------------------------------

ipv4_to_hex()
{
    ip_address=$1

    old_ifs=$IFS
    IFS=.
    # The value comes from "ip", so it does not contain shell globbing.
    # shellcheck disable=SC2086
    set -- $ip_address
    IFS=$old_ifs

    [ "$#" -eq 4 ] || return 1

    printf '%02x%02x%02x%02x' "$1" "$2" "$3" "$4"
}


# ----------------------------------------------------------------------
# Encode a dotted DNS name as hexadecimal DNS labels.
#
# Example:
#   mybox.local
# becomes:
#   056d79626f78056c6f63616c00
#
# This deliberately avoids "set -- $name", because service instance names
# may contain spaces, for example "mybox SSH".
# ----------------------------------------------------------------------

dns_name_hex()
{
    dns_name=$1
    encoded_name=""
    remaining=$dns_name

    while [ -n "$remaining" ]; do
        case "$remaining" in
            *.*)
                label=${remaining%%.*}
                remaining=${remaining#*.}
                ;;
            *)
                label=$remaining
                remaining=""
                ;;
        esac

        [ -n "$label" ] || return 1
        [ "${#label}" -le 63 ] || return 1

        label_length=$(printf '%02x' "${#label}") || return 1
        label_hex=$(printf '%s' "$label" | od -An -tx1 | tr -d ' \n') || return 1

        encoded_name="${encoded_name}${label_length}${label_hex}"
    done

    printf '%s00' "$encoded_name"
}


# ----------------------------------------------------------------------
# Convert hexadecimal bytes to printf %b escape text.
#
# Example:
#   aabb -> \xaa\xbb
#
# The result is text, not binary, so it is safe to store in a shell
# variable and later pass to printf '%b'.
# ----------------------------------------------------------------------

packet_from_hex()
{
    hex_packet=$1
    payload=""
    offset=1

    while [ "$offset" -le "${#hex_packet}" ]; do
        byte=$(printf '%s' "$hex_packet" | cut -c "$offset-$((offset + 1))")
        payload="${payload}\\x${byte}"
        offset=$((offset + 2))
    done

    printf '%s' "$payload"
}


# ----------------------------------------------------------------------
# Build an A-record announcement.
# ----------------------------------------------------------------------

make_a_record_payload()
{
    ip_address=$1
    hex_ip=$(ipv4_to_hex "$ip_address") || return 1
    name_hex=$(dns_name_hex "${HOSTNAME}.local") || return 1

    # DNS header:
    # ID=0, flags=0x8400, questions=0, answers=1,
    # authority=0, additional=0.
    dns_header="000084000000000100000000"

    # A record:
    # type=A, class=IN+cache-flush, TTL, length=4, IPv4 address.
    dns_record="${name_hex}00018001$(printf '%08x' "$DNS_TTL")0004${hex_ip}"

    packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build a PTR-record announcement.
#
# Example:
#   _ssh._tcp.local PTR mybox SSH._ssh._tcp.local
# ----------------------------------------------------------------------

make_ptr_record_payload()
{
    service_name=$1
    instance_name=$2

    service_hex=$(dns_name_hex "${service_name}.local") || return 1
    target_hex=$(dns_name_hex "${instance_name}.${service_name}.local") || return 1

    target_length=$(( ${#target_hex} / 2 ))
    target_length_hex=$(printf '%04x' "$target_length") || return 1

    dns_header="000084000000000100000000"

    # PTR records are shared records, so use class IN without cache flush.
    dns_record="${service_hex}000c0001$(printf '%08x' "$DNS_TTL")${target_length_hex}${target_hex}"

    packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build an SRV-record announcement.
# ----------------------------------------------------------------------

make_srv_record_payload()
{
    instance_name=$1
    service_name=$2
    port=$3
    target_host=$4

    name_hex=$(dns_name_hex "${instance_name}.${service_name}.local") || return 1
    target_hex=$(dns_name_hex "${target_host}.local") || return 1

    port_hex=$(printf '%04x' "$port") || return 1
    target_length=$(( ${#target_hex} / 2 ))
    record_length=$((6 + target_length))
    record_length_hex=$(printf '%04x' "$record_length") || return 1

    dns_header="000084000000000100000000"

    # Priority=0, weight=0, port, target hostname.
    dns_record="${name_hex}00210001$(printf '%08x' "$DNS_TTL")${record_length_hex}00000000${port_hex}${target_hex}"

    packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Build a TXT-record announcement.
# ----------------------------------------------------------------------

make_txt_record_payload()
{
    instance_name=$1
    service_name=$2
    txt_value=$3

    name_hex=$(dns_name_hex "${instance_name}.${service_name}.local") || return 1

    if [ -n "$txt_value" ]; then
        txt_bytes=$(printf '%s' "$txt_value" | od -An -tx1 | tr -d ' \n') || return 1
        txt_length=$(printf '%02x' "${#txt_value}") || return 1
        txt_hex="${txt_length}${txt_bytes}"
    else
        # One empty TXT string.
        txt_hex="00"
    fi

    record_length=$(( ${#txt_hex} / 2 ))
    record_length_hex=$(printf '%04x' "$record_length") || return 1

    dns_header="000084000000000100000000"

    # TXT records are unique records, so use the cache-flush bit.
    dns_record="${name_hex}00108001$(printf '%08x' "$DNS_TTL")${record_length_hex}${txt_hex}"

    packet_from_hex "${dns_header}${dns_record}"
}


# ----------------------------------------------------------------------
# Send one escaped packet through BusyBox nc.
# ----------------------------------------------------------------------

send_payload()
{
    payload=$1
    ip_address=$2

    if [ "$USE_SOURCE_ADDRESS" -eq 1 ]; then
        printf '%b' "$payload" |
            nc -u -p "$MDNS_PORT" -s "$ip_address" -w 1 \
                "$MDNS_GROUP" "$MDNS_PORT" >/dev/null 2>&1
    else
        printf '%b' "$payload" |
            nc -u -p "$MDNS_PORT" -w 1 \
                "$MDNS_GROUP" "$MDNS_PORT" >/dev/null 2>&1
    fi
}


# ----------------------------------------------------------------------
# Announce one address.
# ----------------------------------------------------------------------

announce_address()
{
    iface=$1
    ip_address=$2

   _logger "Announcing ${HOSTNAME}.local -> ${ip_address} via ${iface}"

    payload=$(make_a_record_payload "$ip_address") || return 1
    send_payload "$payload" "$ip_address"

    if [ "$ADVERTISE_SSH" -eq 1 ]; then
        ssh_instance="${HOSTNAME} SSH"

        payload=$(make_ptr_record_payload "_ssh._tcp" "$ssh_instance") || return 1
        send_payload "$payload" "$ip_address"

        payload=$(make_srv_record_payload \
            "$ssh_instance" "_ssh._tcp" "$SSH_PORT" "$HOSTNAME") || return 1
        send_payload "$payload" "$ip_address"

        payload=$(make_txt_record_payload \
            "$ssh_instance" "_ssh._tcp" "") || return 1
        send_payload "$payload" "$ip_address"
    fi

    if [ "$ADVERTISE_HTTP" -eq 1 ]; then
        http_instance="${HOSTNAME} Web"

        payload=$(make_ptr_record_payload "_http._tcp" "$http_instance") || return 1
        send_payload "$payload" "$ip_address"

        payload=$(make_srv_record_payload \
            "$http_instance" "_http._tcp" "$HTTP_PORT" "$HOSTNAME") || return 1
        send_payload "$payload" "$ip_address"

        payload=$(make_txt_record_payload \
            "$http_instance" "_http._tcp" "path=${HTTP_PATH}") || return 1
        send_payload "$payload" "$ip_address"
    fi
}


# ----------------------------------------------------------------------
# Enumerate all active IPv4 addresses.
# ----------------------------------------------------------------------

send_all_announcements()
{
    ip -o -4 addr show up 2>/dev/null |
        while read -r _ iface _ address _; do
            ip_address=${address%/*}

            case "$ip_address" in
                127.*|0.*)
                    continue
                    ;;
            esac

            announce_address "$iface" "$ip_address" || {
                error "Failed to announce $ip_address on $iface"
            }
        done
}


# ----------------------------------------------------------------------
# Usage.
# ----------------------------------------------------------------------

usage() {
[ "$2" ] && error "$2"
local outfh=2
[ "$1" -eq 0 ] && outfh=1

cat >&$outfh <<-__EOF__

usage: tiny-mdns-ann [--host <host-name>] [--http[=port]] [--ssh[=port]]

Simply annonces hostname.local IP address over mdns/avahi on LAN,
and optionally advertizes http (port 80) and/or ssh (port 22) services.
Only requires netcat from Busybox or standalone nc utility.
Lowest footprint & best-effort unsolicited announcer (not a mdns responder).

Options: --help              Help information and usage
         --host <host-name>  Specify host name to be announced in .local domain
         --http[=port]       Announce http service (port 80 by default)
         --ssh[=port]        Announce ssh service (port 22 by default)

__EOF__
exit "$1"
}

# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

! which nc > /dev/null && \
	usage 1 "This tool requires netcat utility from Busybox or standalone; exiting."

OPTS=$(getopt -o "" -l help,host:,http::,ssh:: -n "$SCRIPT" -- "$@") || usage 1
eval set -- "$OPTS"
while true; do
	case "$1" in
		--help) echo "$SCRIPT $VERSION"; usage 0;;
		--host) shift; HOSTNAME="$1";;
		--http) ADVERTISE_HTTP=1; [ -n "$2" ] && HTTP_PORT="$2" && shift;;
		--ssh) ADVERTISE_SSH=1; [ -n "$2" ] && SSH_PORT="$2" && shift;;
		--) break;;
	esac
	shift
done

# Parameters Validation
case "$HOSTNAME" in
    ""|*[!A-Za-z0-9-]*)
        usage 1 "Invalid HOSTNAME: use only letters, digits, and '-'"
        ;;
esac

if [ "${#HOSTNAME}" -gt 63 ]; then
    usage 1 "HOSTNAME is longer than 63 characters"
fi

case "$INTERVAL:$MDNS_PORT:$DNS_TTL:$SSH_PORT:$HTTP_PORT" in
    *[!0-9:]*)
        usage 1 "INTERVAL, ports, and DNS_TTL must be numeric"
        ;;
esac

case "$ADVERTISE_SSH:$ADVERTISE_HTTP:$USE_SOURCE_ADDRESS" in
    *[!01:]*)
        usage 1 "ADVERTISE_SSH, ADVERTISE_HTTP, and USE_SOURCE_ADDRESS must be 0 or 1"
        ;;
esac


_logger "Starting mDNS announcer for ${HOSTNAME}.local"

# Initial announcement burst.
send_all_announcements
sleep 1
send_all_announcements
sleep 2
send_all_announcements

# Periodic announcements.
while :; do
    sleep "$INTERVAL"
    send_all_announcements
done

